{
  "name": "aacp-ts",
  "version": "1.3.0",
  "description": "Agent Action Compression Protocol \u2014 TypeScript SDK for multi-agent LLM coordination",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "npx ts-node --compiler-options '{\"module\":\"CommonJS\"}' tests/smoke.test.ts",
    "dev": "npx tsx src/index.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "aacp",
    "agents",
    "multi-agent",
    "llm",
    "protocol",
    "coordination",
    "ai",
    "typescript"
  ],
