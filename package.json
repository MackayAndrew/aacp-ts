  "license": "MIT",
  "homepage": "https://aacp.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/MackayAndrew/aacp-ts"
  },
  "bugs": {
    "url": "https://github.com/MackayAndrew/aacp-ts/issues"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}